            }
        },
        {
            "name": "Shinobu Sanosuke",
            "id": "13d15232-a017-4d43-851a-6af7bb00497e",
            "investigator": "Shinobu Sanosuke",
            "project_number": 5,
            "front": {
                "classes": [
                    "neutral"
                ],
                "flavor_text": "„Niemand sollte das Nirwana erreichen, ohne den Geschmack von gutem Sake auf den Lippen zu haben.“",
                "health": "7",
                "illustration": "./images/bm-solari-dm1-removebg-preview (1).png",
                "illustration_pan_x": 126.0,
                "illustration_pan_y": 285.0,
                "illustrator": "Illus. BM Solari",
                "sanity": "7",
                "subtitle": "Der Mönch",
                "text": "Du beginnst das Spiel mit Hundehaar <i>(Absinth-Elixier)</i> im Spiel.\n<free> Gib 1 Vorrat von Hundehaar aus: Du erhältst +1 auf deinen Fertigkeitswert für diese Probe. <i>(Max. ein Mal pro Zug.)</i>\n<elder_sign>-Effekt: +X. X ist die Anzahl an Vorräten auf Hundehaar.",
                "title": "<unique><name>",
                "traits": "Gelehrter. Herumtreiber.",
                "type": "investigator"
            },
            "back": {
                "entries": [
                    [
                        "<b>Deckgröße:</b>",
                        "30"
                    ],
                    [
                        "<b>Wahl der Klassen:</b>",
                        "Wähle beim Deckbau 2 Klassen: Wächter (<guardian>), Sucher (<seeker>), Schurke (<rogue>), Mystiker (<mystic>) oder Überlebender (<survivor>)."
                    ],
                    [
                        "<b>Deckbau-Optionen:</b>",
                        "<t>Illegal</t>-Karten Stufe 0-5, Neutrale Karten Stufe 0-5, Karten deiner gewählten Klassen Stufe 0-3."
                    ],
                    [
                        "<b>Deckbau-Voraussetzungen</b> (zählen nicht gegen die Deckgröße):",
                        "Hundehaar, Kalter Entzug, 1 zufällige Grundschwäche."
                    ],
                    [
                        "<b>Zusätzliche Einschränkungen:</b>",
                        "Keine <t>Gelassenheit</t>-Vorteilskarten."
                    ]
                ],
                "flavor_text": "Shinobu war ein mittelloser Säufer, als er vom legendären „betrunkenen Meister“ Hiro Hachimura unter seine Fittiche genommen wurde. Unter der Anleitung seines Meisters entwickelte Shinobu schnell ein Talent für die handwerkliche Braukunst, doch Shinobus „Markenzeichen“ – ein mit Absinth angereichertes Gebräu – erwies sich selbst für seinen Meister als zu gewaltig. Seitdem der „betrunkene Meister“ unerwartet ins Koma fiel, sucht sein Schüler nach immer exotischeren Zutaten, um sein esoterisches Brauarsenal zu erweitern, in der Hoffnung, eines Tages eine Tinktur zu brauen, die seinen Meister zurückbringen könnte …",
                "illustration": "./images/bm-solari-dm1.jpg",
                "illustration_pan_x": -15.0,
                "illustration_pan_y": 70.0,
                "illustration_scale": 0.705,
                "text": "<b>Deckgröße:</b> 30\n<b>Wahl der Klassen:</b> Wähle beim Deckbau 2 Klassen: Wächter (<guardian>), Sucher (<seeker>), Schurke (<rogue>), Mystiker (<mystic>) oder Überlebender (<survivor>).\n<b>Deckbau-Optionen:</b> <t>Illegal</t>-Karten Stufe 0-5, Neutrale Karten Stufe 0-5, Karten deiner gewählten Klassen Stufe 0-3.\n<b>Deckbau-Voraussetzungen</b> (zählen nicht gegen die Deckgröße): Hundehaar, Kalter Entzug, 1 zufällige Grundschwäche.\n<b>Zusätzliche Einschränkungen:</b> Keine <t>Gelassenheit</t>-Vorteilskarten.",
                "type": "investigator_back"
            }
        },
